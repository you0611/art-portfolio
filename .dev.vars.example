# Copy to .dev.vars for local admin-route testing. Never commit real values.
ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ACCESS_AUD=replace-with-cloudflare-access-audience
ADMIN_EMAIL=replace-with-the-single-admin-email
# Keep local delivery safe until Gmail OAuth has been completed and a real send is intended.
EMAIL_MODE=local-fake
GMAIL_FROM_EMAIL=replace-with-gmail-sender
GMAIL_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=replace-with-gmail-refresh-token

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youxianglong-art-studio",
  "compatibility_date": "2026-08-21",
  "pages_build_output_dir": "./dist",
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "yx-art-studio-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yx-art-studio-commerce",
      "database_id": "47b72d1b-d7f0-4ca0-be11-a402d9dbd620",
      "migrations_dir": "migrations"
    }
  ]
}
